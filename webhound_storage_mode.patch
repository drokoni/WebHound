+fn default_text_output_path(input_jsonl: &PathBuf) -> PathBuf {
+    let parent = input_jsonl
+        .parent()
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("."));
+
+    let stem = input_jsonl
+        .file_stem()
+        .and_then(|s| s.to_str())
+        .unwrap_or("sensitive_info");
+
+    let ext = input_jsonl
+        .extension()
+        .and_then(|s| s.to_str())
+        .unwrap_or("jsonl");
+
+    parent.join(format!("{stem}.ml.{ext}"))
+}
