<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Eyeballer ONNX Report</title>
  <style>
    body {
      font-family:
        system-ui,
        Segoe UI,
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
      margin: 24px;
    }

    table {
      border-collapse: collapse;
      width: 100%;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 8px;
      font-size: 14px;
      vertical-align: top;
    }

    th {
      background: #f5f5f5;
      cursor: pointer;
      user-select: none;
    }

    th.sort-asc::after {
      content: " ▲";
      font-size: 11px;
    }

    th.sort-desc::after {
      content: " ▼";
      font-size: 11px;
    }

    img.thumb {
      height: 110px;
    }

    .prob {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .controls {
      margin-bottom: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .controls label {
      font-size: 14px;
    }

    button {
      padding: 6px 10px;
    }

    #status {
      font-size: 13px;
      opacity: 0.9;
    }

    select {
      padding: 4px;
    }
  </style>
</head>

<body>
  <h1>Eyeballer ONNX Report</h1>
  <p>
    Images dir: <code>{IMAGES_DIR}</code> · Predictions CSV:
    <a href="./{CSV_NAME}">{CSV_NAME}</a> · Annotations:
    <a href="./annotations.csv">annotations.csv</a>
  </p>

  <div class="controls">
    <label>
      Фильтр по manual label:
      <select id="labelFilter">
        <option value="">(все)</option>
      </select>
    </label>

    <button id="btnSave">Сохранить annotations.csv</button>
    <button id="btnDownload">Скачать annotations.csv</button>
    <button id="btnReset">Сбросить manual=pred</button>

    <span id="countInfo"></span>
    <span id="status"></span>
  </div>

  <table id="reportTable">
    <thead>
      <tr>
        <th data-col="image" data-sortable="false">Image</th>
        <th data-col="top_label" data-sortable="true">Pred label</th>
        <th data-col="top_prob" data-sortable="true">Pred prob</th>
        <th data-col="manual_label" data-sortable="true">Manual label</th>
        <th data-col="all_probs" data-sortable="false">All probs</th>
      </tr>
    </thead>
    <tbody id="rows"></tbody>
  </table>

  <script>
    const STATE = {
      rows: [],
      filtered: [],
      sort: {col: null, dir: "asc"},
      labels: [],
    };

    function parseCsvLine(line) {
      const out = [];
      let cur = "";
      let inQ = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (inQ) {
          if (ch === '"' && line[i + 1] === '"') {
            cur += '"';
            i++;
          } else if (ch === '"') inQ = false;
          else cur += ch;
        } else {
          if (ch === '"') inQ = true;
          else if (ch === ",") {
            out.push(cur);
            cur = "";
          } else cur += ch;
        }
      }
      out.push(cur);
      return out;
    }

    function csvEsc(v) {
      const s = String(v ?? "");
      if (/[,"\r\n]/.test(s)) return `"${s.replaceAll('"', '""')}"`;
      return s;
    }

    function setStatus(msg) {
      const el = document.getElementById("status");
      el.textContent = msg ? `· ${msg}` : "";
    }

    async function fetchTextIfExists(name) {
      const r = await fetch(name);
      if (!r.ok) return null;
      return await r.text();
    }

    async function main() {
      const csvName = "{CSV_NAME}";
      const predText = await fetch(csvName).then((r) => r.text());

      const predLines = predText.trim().split(/\r?\n/);
      const predHead = parseCsvLine(predLines.shift());
      const idx = Object.fromEntries(predHead.map((h, i) => [h, i]));

      // список меток берём из заголовков p_*
      const labels = predHead
        .filter((h) => h.startsWith("p_"))
        .map((h) => h.slice(2));
      STATE.labels = labels;

      // попытаемся подгрузить существующую разметку
      const annText = await fetchTextIfExists("annotations.csv");
      const annMap = new Map();

      if (annText) {
        const annLines = annText.trim().split(/\r?\n/);
        const annHead = parseCsvLine(annLines.shift());
        const aidx = Object.fromEntries(annHead.map((h, i) => [h, i]));
        for (const line of annLines) {
          if (!line.trim()) continue;
          const cols = parseCsvLine(line);
          const file = cols[aidx["file"]];
          const ml = cols[aidx["manual_label"]];
          if (file) annMap.set(file, ml);
        }
      }

      const allRows = [];
      const labelSet = new Set(labels);

      for (const line of predLines) {
        if (!line.trim()) continue;
        const cols = parseCsvLine(line);

        const file = cols[idx["file"]];
        const topLabel = cols[idx["top_label"]];
        const topProb = Number(cols[idx["top_prob"]]) || 0;

        const probsHtml = predHead
          .filter((h) => h.startsWith("p_"))
          .map((h) => `${h}=${Number(cols[idx[h]]).toFixed(4)}`)
          .join("<br>");

        const manual = annMap.get(file) || topLabel;
        labelSet.add(manual);

        allRows.push({
          file,
          top_label: topLabel,
          top_prob: topProb,
          probs_html: probsHtml,
          manual_label: manual,
        });
      }

      STATE.rows = allRows;

      // селект фильтра
      const labelFilter = document.getElementById("labelFilter");
      [...labelSet].sort().forEach((lbl) => {
        const opt = document.createElement("option");
        opt.value = lbl;
        opt.textContent = lbl;
        labelFilter.appendChild(opt);
      });

      labelFilter.addEventListener("change", () => applyFilterAndRender());

      // сортировка
      const thead = document.querySelector("#reportTable thead");
      thead.addEventListener("click", (ev) => {
        const th = ev.target.closest("th");
        if (!th) return;
        const col = th.dataset.col;
        const sortable = th.dataset.sortable === "true";
        if (!sortable) return;

        if (STATE.sort.col === col) {
          STATE.sort.dir = STATE.sort.dir === "asc" ? "desc" : "asc";
        } else {
          STATE.sort.col = col;
          STATE.sort.dir = "asc";
        }
        applyFilterAndRender();
      });

      // кнопки
      document.getElementById("btnReset").addEventListener("click", () => {
        for (const r of STATE.rows) r.manual_label = r.top_label;
        applyFilterAndRender();
        setStatus("manual labels сброшены");
      });

      document.getElementById("btnDownload").addEventListener("click", () => {
        const csv = buildAnnotationsCsv();
        const blob = new Blob([csv], {type: "text/csv;charset=utf-8"});
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "annotations.csv";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setStatus("annotations.csv скачан");
      });

      document
        .getElementById("btnSave")
        .addEventListener("click", async () => {
          setStatus("сохраняю...");
          const csv = buildAnnotationsCsv();
          try {
            const r = await fetch("/api/annotations", {
              method: "POST",
              headers: {"Content-Type": "text/csv;charset=utf-8"},
              body: csv,
            });
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            setStatus("сохранено в report/annotations.csv");
          } catch (e) {
            setStatus(`ошибка сохранения: ${e}`);
          }
        });

      applyFilterAndRender();
    }

    function buildAnnotationsCsv() {
      const lines = [];
      lines.push(["file", "manual_label"].map(csvEsc).join(","));
      // фиксируем порядок — по file
      const rows = [...STATE.rows].sort((a, b) =>
        String(a.file).localeCompare(String(b.file)),
      );
      for (const r of rows) {
        lines.push([r.file, r.manual_label].map(csvEsc).join(","));
      }
      return lines.join("\n") + "\n";
    }

    function applyFilterAndRender() {
      const selected = document.getElementById("labelFilter").value;
      let data = STATE.rows;

      if (selected) data = data.filter((r) => r.manual_label === selected);

      if (STATE.sort.col) {
        const {col, dir} = STATE.sort;
        data = [...data].sort((a, b) => {
          let av = a[col];
          let bv = b[col];
          if (col === "top_prob") {
            av = Number(av);
            bv = Number(bv);
            return dir === "asc" ? av - bv : bv - av;
          }
          return dir === "asc"
            ? String(av).localeCompare(String(bv))
            : String(bv).localeCompare(String(av));
        });
      }

      STATE.filtered = data;
      renderTable();
    }

    function renderTable() {
      const tbody = document.getElementById("rows");
      tbody.innerHTML = "";

      for (const row of STATE.filtered) {
        const tr = document.createElement("tr");

        // Image
        const tdImg = document.createElement("td");
        const img = document.createElement("img");
        img.className = "thumb";
        // важно: оставляем ./file (сервер отдаст из parent)
        img.src = encodeURI(
          row.file.startsWith("./") ? row.file : `./${row.file}`,
        );
        img.onerror = () => {
          tdImg.textContent = row.file;
        };
        tdImg.appendChild(img);

        // Pred label
        const tdPred = document.createElement("td");
        tdPred.textContent = row.top_label;

        // Pred prob
        const tdProb = document.createElement("td");
        tdProb.className = "prob";
        tdProb.textContent = row.top_prob.toFixed(4);

        // Manual label select
        const tdMan = document.createElement("td");
        const sel = document.createElement("select");
        for (const lbl of STATE.labels) {
          const opt = document.createElement("option");
          opt.value = lbl;
          opt.textContent = lbl;
          sel.appendChild(opt);
        }
        // если в annotations встретилась метка не из labels — добавим её
        if (![...sel.options].some((o) => o.value === row.manual_label)) {
          const opt = document.createElement("option");
          opt.value = row.manual_label;
          opt.textContent = row.manual_label;
          sel.appendChild(opt);
        }
        sel.value = row.manual_label;
        sel.addEventListener("change", () => {
          row.manual_label = sel.value;
          setStatus("изменено (не забывай сохранить)");
          // обновим фильтр/счётчик без полного пересоздания фильтра
          applyFilterAndRender();
        });
        tdMan.appendChild(sel);

        // All probs
        const tdAll = document.createElement("td");
        tdAll.className = "prob";
        tdAll.innerHTML = row.probs_html;

        tr.appendChild(tdImg);
        tr.appendChild(tdPred);
        tr.appendChild(tdProb);
        tr.appendChild(tdMan);
        tr.appendChild(tdAll);

        tbody.appendChild(tr);
      }

      document.getElementById("countInfo").textContent =
        `Показано ${STATE.filtered.length} из ${STATE.rows.length}`;

      const ths = document.querySelectorAll("#reportTable thead th");
      ths.forEach((th) => {
        th.classList.remove("sort-asc", "sort-desc");
        const col = th.dataset.col;
        if (col && col === STATE.sort.col) {
          th.classList.add(
            STATE.sort.dir === "asc" ? "sort-asc" : "sort-desc",
          );
        }
      });
    }

    main();
  </script>
</body>

</html>
